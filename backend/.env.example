PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>
JWT_SECRET=your_jwt_secret_here

# Comma-separated list of allowed frontend origins (add your Vercel URL here for production)
# e.g. FRONTEND_URL=https://your-app.vercel.app
# or   FRONTEND_URL=https://your-app.vercel.app,https://your-custom-domain.com
FRONTEND_URL=

# Set to "production" on Render (hides stack traces in error responses)
NODE_ENV=development

# SMTP settings for sending purchase request emails to dealers
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@example.com
